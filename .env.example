# Local environment config template for regime-rader.
# Copy this file to .env and populate it with real values.

# ECOS (한국은행) StatisticSearch API key -- required by data/ecos_fetch.py
# for every real-data fetch in this project (KTB yield, KOSPI, CD91, gold),
# and transitively by api/pipeline.py's regime/HRP/backtest endpoints.
# Get a key at https://ecos.bok.or.kr/api/#/ (무료 오픈API 신청).
ECOS_API_KEY=
